<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Contactless NFC signal waves emitting from the card -->
    <path
        android:pathData="M 42 24 A 12 12 0 0 1 66 24"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 37 19 A 18 18 0 0 1 71 19"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 32 14 A 24 24 0 0 1 76 14"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4"
        android:fillColor="#00000000" />

    <!-- Sleek Rounded Play Credit Card Base -->
    <path android:pathData="M 21 34 h 66 a 5 5 0 0 1 5 5 v 38 a 5 5 0 0 1 -5 5 h -66 a 5 5 0 0 1 -5 -5 v -38 a 5 5 0 0 1 5 -5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="34"
                android:endX="92"
                android:endY="82"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#D500F9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing border around the credit card -->
    <path
        android:pathData="M 21 34 h 66 a 5 5 0 0 1 5 5 v 38 a 5 5 0 0 1 -5 5 h -66 a 5 5 0 0 1 -5 -5 v -38 a 5 5 0 0 1 5 -5 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.8"
        android:fillColor="#00000000" />

    <!-- Credit Card Smart Chip -->
    <path
        android:pathData="M 26 42 h 12 a 2 2 0 0 1 2 2 v 8 a 2 2 0 0 1 -2 2 h -12 a 2 2 0 0 1 -2 -2 v -8 a 2 2 0 0 1 2 -2 Z"
        android:fillColor="#FFD600" />
    <path
        android:pathData="M 26 46 h 14 M 32 42 v 12"
        android:strokeColor="#511281"
        android:strokeWidth="0.8" />

    <!-- Game Controller D-pad (Left side of Card) -->
    <path
        android:pathData="M 28 62 h 5 v -5 h 4 v 5 h 5 v 4 h -5 v 5 h -4 v -5 h -5 Z"
        android:fillColor="#FFFFFF" />

    <!-- Game Controller Buttons (Right side of Card) -->
    <!-- Button X (Top Right) -->
    <path
        android:pathData="M 72 54 A 3 3 0 1 1 72 53.99 Z"
        android:fillColor="#00E5FF" />
    <!-- Button Y (Right) -->
    <path
        android:pathData="M 79 49 A 3 3 0 1 1 79 48.99 Z"
        android:fillColor="#FFD600" />
    <!-- Button A (Bottom Right) -->
    <path
        android:pathData="M 78 61 A 3 3 0 1 1 78 60.99 Z"
        android:fillColor="#FF1744" />

    <!-- NFC Wave icon embedded in bottom center of card -->
    <path
        android:pathData="M 50 64 A 4 4 0 0 1 58 64 M 47 64 A 7 7 0 0 1 61 64"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeAlpha="0.9" />

</vector>
